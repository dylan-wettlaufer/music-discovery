# Spotify app in development mode. The redirect URI must be allowlisted.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Host CLI. The Compose app service overrides this to reach the db container.
DATABASE_URL=postgresql+psycopg://music:music@localhost:5432/music_discovery

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
